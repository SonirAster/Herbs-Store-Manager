<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id='hs_stock_action' model='ir.actions.act_window'>
        <field name='name'>Stock</field>
        <field name='res_model'>hs.stock</field>
        <field name='view_mode'>kanban,list,form</field>
        <field name="help" type='html'>
            <p class="o_view_nocontent_smiling_face">
                Create a new stock item
            </p>
        </field>
    </record>

    <record id="hs_stock_view_tree" model="ir.ui.view">
        <field name="name">hs.stock.view.tree</field>
        <field name="model">hs.stock</field>
        <field name="arch" type="xml">
            <list string="Stock items list">
                <field name="name"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <record id="hs_stock_view_form" model="ir.ui.view">
        <field name="name">hs.stock.view.form</field>
        <field name="model">hs.stock</field>
        <field name="arch" type="xml">
            <form string="Stock item form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="cost"/>
                            <field name="price"/>
                            <notebook>
                                <page string="Description">
                                    <field name="description"/> 
                                </page>
                                <page string="Propeties">
                                    <field name="properties"/>
                                </page>
                            </notebook>
                        </group>
                        <field name="image" class="w-120" widget="image" alt="Stock image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hs_stock_view_kanban" model="ir.ui.view">
        <field name="name">hs.stock.view.kanban</field>
        <field name="model">hs.stock</field>
        <field name="arch" type="xml">
            <kanban string="Stock Items kanban">
                <templates>
                    <t t-name="kanban-box">
                        <t t-name='card'  class="flex-row">
                            <main class="ps-2 ps-md-0">
                                <h4><field name="name"/></h4>
                                <div>
                                    <span>Quantity: </span>
                                    <field name="quantity" />
                                </div> 
                                <div>
                                    <span>Price: </span>
                                    <field name="price" />
                                </div>
                                <div>
                                    <span>Cost: </span>
                                    <field name="cost" />
                                </div>
                            </main>
                            <aside class="o_kanban_aside_full">
                                <field name="image" 
                                    class="o_kanban_image_fill w-120" 
                                    widget="image" 
                                    options="{'img_class': 'object-fit-cover'}" 
                                    alt="Stock image"/>
                            </aside>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hs_stock_search" model="ir.ui.view">
        <field name="name">hs.stock.view.search</field>
        <field name="model">hs.stock</field>
        <field name="arch" type="xml">
            <search string="hs stock search">
                <field name="description" string="Product name and description"
                    filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/> 
                <field name="properties" string="Properties"
                    filter_domain="[('properties', 'ilike', self)"/> 
                <filter string="Is running out" name="is_running_out" domain="[('quantity', '&lt;', 5)]" />
            </search>
        </field>
    </record>

</odoo>