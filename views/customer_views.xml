<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id='hs_customers_action' model='ir.actions.act_window'>
        <field name='name'>Customers list</field>
        <field name='res_model'>res.partner</field>
        <field name='view_mode'>list,form,kanban</field>
        <field name="help" type='html'>
            <p class="o_view_nocontent_smiling_face">
                Create a new customer record
            </p>
        </field>
    </record>

    <record id="hs_customer_view_tree" model="ir.ui.view">
        <field name="name">res.partner.view.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="hs list">
                <field name="name"/>
                <field name="active_order_ids"/>
            </list>
        </field>
    </record>

    <record id="hs_customer_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="hs customers list">
                <sheet>
                   <group>
                        <group>
                            <field name="name"/>
                            <field name="active_order_count"/>
                        </group>
                        <group>
                            <field name="active_order_ids">
                                <list>
                                    <field name='id' />
                                    <field name='name' />
                                    <field name='urgency' />
                                    <field name='delivery_point' />
                                    <field name='price' />
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>